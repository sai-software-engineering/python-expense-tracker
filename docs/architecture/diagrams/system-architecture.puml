@startuml

title Python Expense Tracker - System Architecture

skinparam componentStyle rectangle
skinparam shadowing false

actor User

package "Presentation Layer" {
    component "Web Browser" as Browser
    component "HTML5 / CSS3 / JavaScript" as Frontend
}

package "Application Layer" {

    component "FastAPI Application" as API

    component "Transaction Management" as Transaction
    component "Category Management" as Category
    component "Report Generation" as Reports

    component "Pydantic Validation" as Validation
}

package "Data Access Layer" {
    component "SQLAlchemy ORM" as ORM
}

database "SQLite Database" as DB

User --> Browser
Browser --> Frontend

Frontend --> API : HTTP Requests / JSON

API --> Validation
Validation --> Transaction
Validation --> Category
Validation --> Reports

Transaction --> ORM
Category --> ORM
Reports --> ORM

ORM --> DB : SQL Queries

@enduml